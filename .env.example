COMPOSE_PROFILES=local
APP_MODE=local
APP_URL=http://localhost:3100
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_HEX_AT_LEAST_32_CHARACTERS
SMTP_HOST=mail
SMTP_PORT=1025
MAIL_FROM=support@example.test
