COMPOSE_PROFILES=local
# Portfolio demo (README): COMPOSE_PROFILES=local,demo and DEMO_PUBLIC_HOSTS=northwind.demo.test. Local only; hosted mode refuses it.
DEMO_PUBLIC_HOSTS=
APP_MODE=local
APP_URL=http://localhost:3100
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_HEX_AT_LEAST_32_CHARACTERS
SMTP_HOST=mail
SMTP_PORT=1025
MAIL_FROM=support@example.test
SEED_OWNER_EMAIL=REPLACE_WITH_VERIFIED_DEMO_EMAIL
SEED_OWNER_PASSWORD=REPLACE_WITH_THAT_ACCOUNTS_PASSWORD
SEED_SUPPORT_PASSWORD=REPLACE_WITH_A_NEW_PASSWORD_FOR_THE_DEMO_SUPPORT_OPERATOR
# Optional: encrypts Business action credentials (openssl rand -hex 32). Without it, credentials cannot be stored or used.
ACTION_CREDENTIAL_KEY=
# Optional connected generation: keys reach only the worker. Real calls also need compose.connected.yaml (see README, Providers).
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# Optional Jev typed workflow decisions (TypeSafe); worker only, also needs compose.connected.yaml.
TYPESAFE_API_KEY=
# Optional cost estimates, USD per million input/output tokens per served model, e.g. {"deepseek/deepseek-flash":[0.5,2],"jev/jev-1.13.0":[0.042,0]}
PROVIDER_RATES=
